# API Configuration
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# Authentication
VITE_AUTH_STORAGE_KEY=hospital_metrics_auth
VITE_TOKEN_REFRESH_INTERVAL=600000  # 10 minutes in milliseconds

# Feature Flags
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_3D_EFFECTS=true
VITE_ENABLE_ANIMATIONS=true

# Performance
VITE_MAX_FLOOR_INSTANCES=100
VITE_GEOMETRY_DETAIL_LEVEL=high  # low, medium, high
VITE_ENABLE_SHADOWS=true

# Development
VITE_DEBUG_MODE=true
VITE_MOCK_API=false
