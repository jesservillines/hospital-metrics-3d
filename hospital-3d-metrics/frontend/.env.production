# API Configuration
VITE_API_URL=https://your-api-domain/api/v1
VITE_WS_URL=wss://your-api-domain/ws

# Authentication
VITE_AUTH_STORAGE_KEY=hospital_metrics_auth
VITE_TOKEN_REFRESH_INTERVAL=600000

# Feature Flags
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_3D_EFFECTS=true
VITE_ENABLE_ANIMATIONS=true

# Performance
VITE_MAX_FLOOR_INSTANCES=50
VITE_GEOMETRY_DETAIL_LEVEL=medium
VITE_ENABLE_SHADOWS=false

# Development
VITE_DEBUG_MODE=false
VITE_MOCK_API=false
